{
  "extends": "../tsconfig.json",
  "include": ["src/**/*", "../shared/**/*"],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "../dist/client-types",
    "rootDir": "..",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    }
  }
}
